# Copy to .env and fill in. Nothing here is required to run it on one machine.

# Port to listen on.
PORT=4200

# Postgres. Unset → data goes to data/tracker.json (fine for one machine, not
# for a team).
# DATABASE_URL=postgres://user:password@host:5432/planning
# DATABASE_SSL=no-verify        # managed Postgres (Neon, Supabase, Render external)
# DATABASE_SCHEMA=planning      # keeps these tables away from anything else in the database

# Signs session tokens. Generate with: openssl rand -hex 32
# Unset → generated on boot, so everybody is signed out on every restart.
SESSION_SECRET=

# Authorises creating the first administrator, so whoever merely finds the URL
# first cannot claim the installation.
ACCESS_CODE=

# Or create the administrator on first boot and skip the setup screen entirely.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# The plant's timezone, so "due today" means today locally rather than in UTC.
TZ=Asia/Riyadh
